rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /polls/{pollId} {
      // Anyone with the link can read the poll (title, timing, reveal flag).
      allow read: if true;

      // Anyone can create a new poll (this app has no login system), but the
      // shape is validated strictly: this is the actual security boundary
      // for the app, since anyone can hit this API directly (not just
      // through the app's own UI) and a permissive `create` here is what
      // would let someone plant malicious data for other visitors to load.
      allow create: if pollId.matches('^[a-z0-9]{6,16}$')
                    && request.resource.data.keys().hasAll(
                         ['title', 'durationSecs', 'endsAt', 'resultsRevealed', 'imageCount', 'expireAt']
                       )
                    && request.resource.data.title is string
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.durationSecs is number
                    && request.resource.data.durationSecs > 0
                    && request.resource.data.durationSecs <= 86400
                    && request.resource.data.imageCount is number
                    && request.resource.data.imageCount >= 2
                    && request.resource.data.imageCount <= 50
                    && request.resource.data.resultsRevealed == false
                    && request.resource.data.endsAt is timestamp
                    && request.resource.data.expireAt is timestamp;

      // The host can toggle resultsRevealed on and off; nothing else about
      // the poll may change after creation.
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['resultsRevealed']);

      // Firestore's native TTL feature requires the Blaze billing plan, so
      // cleanup instead runs as a scheduled job that hits the public REST
      // API with no credentials at all. This rule is what makes that safe:
      // a doc can ONLY be deleted once its own `expireAt` has passed, so a
      // still-live poll can never be deleted no matter who asks.
      allow delete: if resource.data.expireAt < request.time;

      match /images/{imageId} {
        allow read: if true;

        // Written as part of the poll-creation batch; imageId and url are
        // constrained to exactly the shape the app itself produces
        // (String(index) ids, base64 data: URIs) so a crafted id or url
        // can never be planted here for another visitor's browser to render.
        allow create: if imageId.matches('^[0-9]{1,4}$')
                      && request.resource.data.keys().hasAll(['url', 'votes', 'order', 'expireAt'])
                      && request.resource.data.url is string
                      && request.resource.data.url.matches('^data:image/.*')
                      && request.resource.data.votes == 0
                      && request.resource.data.order is number
                      && request.resource.data.expireAt is timestamp;

        // Voting: only allow the `votes` field to increase by exactly 1,
        // and only while the poll's countdown hasn't ended yet.
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
                      && request.resource.data.votes == resource.data.votes + 1
                      && request.time < get(/databases/$(database)/documents/polls/$(pollId)).data.endsAt;

        // Same expiry-gated delete as the parent poll.
        allow delete: if resource.data.expireAt < request.time;
      }
    }
  }
}
